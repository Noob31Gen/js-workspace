{
  "manifest_version": 3,
  "name": "JS Workspace CORS Fetch Helper",
  "version": "1.0.0",
  "description": "Helper extension allowing JS Workspace (js.noob31.com) to perform cross-origin data fetching.",
  "permissions": [],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://js.noob31.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://js.noob31.com/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
